interface: ICPU:
		ADDR_WIDTH = 32
	port: Master / Slave
		addr: net[ADDR_WIDTH]: out / in
		rdata: net[32]: in / out
		wdata: net[32]: out / in
		wmask: net[4]: out / in
		rstrb: net: out / in
		ready: net: in / out
	macros:
		hsdata = { addr, wdata, wmask, rstrb }
		fulldata = { addr, rdata, wdata, wmask, rstrb, ready }

module: CPU:
		RESET_ADDR = 32x0000_0000
		ADDR_WIDTH = 32
	port:
		clk: in
		reset: in

		mem: ICPU.Master(ADDR_WIDTH = ADDR_WIDTH)
	local:
		rs1: net[32]
		rs2: net[32]
		regFile[32]: net[32]

		instr: net[32]

		PC: net[32]
		PCplus4: net[32] = PC + 4
		PCplusImm: net[32] = PC + mux(isJAL, Jimm, mux(isAUIPC, Uimm, Bimm))
		PCnext: net[32] = \
			mux(isJALR, { aluPlus[31 .. 1], 1b0 },
				mux(jumpToPCplusImm, PCplusImm,
					PCplus4))

		rdId: net[5] = instr[11 .. 7]

		\\funct3Is: net[8] = 1 << instr[14 .. 12]
		funct3Is: net[8] = for(i < 8, &(instr[14 .. 12] ^ $number(i, 3, 'd')))

		Uimm: net[32] = { instr[31], instr[30 .. 12], 12b0 }
		Iimm: net[32] = { 21{ instr[31] }, instr[30 .. 20] }

		Simm: net[32] = { 21{ instr[31] }, instr[30 .. 25], instr[11 .. 7] }
		Bimm: net[32] = { 20{ instr[31] }, instr[7], instr[30 .. 25], instr[11 .. 8], 1b0 }
		Jimm: net[32] = { 12{ instr[31] }, instr[19 .. 12], instr[20], instr[30 .. 21], 1b0 }

		isLoad: net = instr[6 .. 2] == 5b00000
		isALUimm: net = instr[6 .. 2] == 5b00100
		isStore: net = instr[6 .. 2] == 5b01000
		isALUreg: net = instr[6 .. 2] == 5b01100
		isSYSTEM: net = instr[6 .. 2] == 5b11100
		isJAL: net = instr[3]
		isJALR: net = instr[6 .. 2] == 5b11001
		isLUI: net = instr[6 .. 2] == 5b01101
		isAUIPC: net = instr[6 .. 2] == 5b00101
		isBranch: net = instr[6 .. 2] == 5b11000

		isALU: net = isALUimm | isALUreg

		aluIn1: net[32] = rs1
		aluIn2: net[32] = mux(isALUreg | isBranch, rs2, Iimm)

		aluBusy: net = |quotient_msk
		aluWr: net = state.EXECUTE & isALU

		aluPlus: net[32] = aluIn1 + aluIn2

		aluMinus: net[33] = { 1b1, ~aluIn2 } + { 1b0, aluIn1 } + 33b1
		LT: net = mux(aluIn1[31] ^ aluIn2[31], aluIn1[31], aluMinus[32])
		LTU: net = aluMinus[32]
		EQ: net = aluMinus[31 .. 0] == 0

		\\ muxes are better than ANDing manually, shows gowin
		aluOut: net[32] = \
			mux(isALUreg & funcM,
				mux(funct3Is[0], multiply[31 .. 0], 32b0) | \
				mux(|funct3Is[3 .. 1], multiply[63 .. 32], 32b0) | \
				mux(instr[14], mux(div_sign, -divResult, divResult), 32b0),
				mux(funct3Is[0], mux(instr[30] & instr[5], aluMinus[31 .. 0], aluPlus), 32b0) | \
				mux(funct3Is[1], leftShift, 32b0) | \
				mux(funct3Is[2], { 31b0, LT }, 32b0) | \
				mux(funct3Is[3], { 31b0, LTU }, 32b0) | \
				mux(funct3Is[4], aluIn1 ^ aluIn2, 32b0) | \
				mux(funct3Is[5], shifter, 32b0) | \
				mux(funct3Is[6], aluIn1 | aluIn2, 32b0) | \
				mux(funct3Is[7], aluIn1 & aluIn2, 32b0)
			)

		predicate: net = \
			funct3Is[0] & EQ | \
			funct3Is[1] & !EQ | \
			funct3Is[4] & LT | \
			funct3Is[5] & !LT | \
			funct3Is[6] & LTU | \
			funct3Is[7] & !LTU

		loadstore_addr: net[32] = rs1 + mux(isStore, Simm, Iimm)

		writeBackData: net[32] = \
			mux(isSYSTEM, cycles, 32b0) | \
			mux(isLUI, Uimm, 32b0) | \
			mux(isALU, aluOut, 32b0) | \
			mux(isAUIPC, PCplusImm, 32b0) | \
			mux(isJALR | isJAL, PCplus4, 32b0) | \
			mux(isLoad, LOAD_data, 32b0)

		mem_byteAccess: net = instr[13 .. 12] == 2b00
		mem_halfwordAccess: net = instr[13 .. 12] == 2b01

		LOAD_sign: net = ~instr[14] & mux(mem_byteAccess, LOAD_byte[7], LOAD_halfword[15])

		LOAD_data: net[32] = \
			mux(mem_byteAccess, { 24{ LOAD_sign }, LOAD_byte },
				mux(mem_halfwordAccess, { 16{ LOAD_sign }, LOAD_halfword },
					mem.rdata))

		LOAD_halfword: net[16] = mux(loadstore_addr[1], mem.rdata[31 .. 16], mem.rdata[15 .. 0])
		LOAD_byte: net[8] = mux(loadstore_addr[0], LOAD_halfword[15 .. 8], LOAD_halfword[7 .. 0])

		STORE_wmask: net[4] = \
			mux(mem_byteAccess,
				mux(loadstore_addr[1],
					mux(loadstore_addr[0], 4b1000, 4b0100),
					mux(loadstore_addr[0], 4b0010, 4b0001)),
				mux(mem_halfwordAccess,
					mux(loadstore_addr[1], 4b1100, 4b0011),
					4b1111))

		writeBack: net = ~(isBranch | isStore) & (state.EXECUTE | state.WAIT_ALU_OR_MEM)

		jumpToPCplusImm: net = isJAL | (isBranch & predicate)
		needToWait: net = isLoad | isStore | isDivide

		cycles: net[32]

		shifter_in: net[32] = mux(funct3Is[1], for(i, aluIn1[i]), aluIn1)
		shifter: net[32] = $signed({ instr[30] & aluIn1[31], shifter_in }) >>> aluIn2[4 .. 0]
		leftShift: net[32] = for(i, shifter[i])

		funcM: net = instr[25]
		isMULH: net = funct3Is[1]
		isMULHSU: net = funct3Is[2]

		sign1: net = aluIn1[31] & isMULH
		sign2: net = aluIn2[31] & (isMULH | isMULHSU)

		signed1: net[33] = { sign1, aluIn1 }
		signed2: net[33] = { sign2, aluIn2 }
		multiply: net[64] = $signed(signed1) * $signed(signed2)

		isDivide: net = isALUreg & funcM & instr[14]
		dividend: net[32]
		divisor: net[63]
		quotient: net[32]
		quotient_msk: net[32]
		divstep_do: net = divisor <= { 31b0, dividend }
		dividendN: net[32] = mux(divstep_do, dividend - divisor[31 .. 0], dividend)
		quotientN: net[32] = mux(divstep_do, quotient | quotient_msk, quotient)
		div_sign: net = ~instr[12] & mux(instr[13], aluIn1[31], (aluIn1[31] != aluIn2[31]) & |aluIn2)
		divResult: net[32]
	fsm:
		state:
			FETCH_INSTR
			EXECUTE
			WAIT_ALU_OR_MEM

	ff: +clk
		if: isDivide & aluWr
			dividend = mux(~instr[12] & aluIn1[31], -aluIn1, aluIn1)
			divisor = { mux(~instr[12] & aluIn2[31], -aluIn2, aluIn2), 31b0 }
			quotient = 0
			quotient_msk = 1 << 31
		else:
			dividend = dividendN
			divisor = divisor >> 1
			quotient = quotientN
			quotient_msk = quotient_msk >> 1

		divResult = mux(instr[13], dividendN, quotientN)

	ff: +clk
		mem.addr = mux(state.FETCH_INSTR, PC, loadstore_addr)

		mem.wdata[7 .. 0] = rs2[7 .. 0]
		mem.wdata[15 .. 8] = mux(loadstore_addr[0], rs2[7 .. 0], rs2[15 .. 8])
		mem.wdata[23 .. 16] = mux(loadstore_addr[1], rs2[7 .. 0], rs2[23 .. 16])
		mem.wdata[31 .. 24] = mux(loadstore_addr[0], rs2[7 .. 0], mux(loadstore_addr[1], rs2[15 .. 8], rs2[31 .. 24]))

		mem.rstrb = ((state.EXECUTE | state.WAIT_ALU_OR_MEM) & isLoad) | state.FETCH_INSTR
		mem.wmask = 4{ (state.EXECUTE | state.WAIT_ALU_OR_MEM) & isStore } & STORE_wmask

		if: reset | mem.ready
			mem.rstrb = 0
			mem.wmask = 0

	ff: +clk
		if: writeBack
			if: rdId != 0
				regFile[rdId] = writeBackData

	ff: +clk
		if: reset
			$goto(state.FETCH_INSTR)
			PC = RESET_ADDR
		else:
			if: state.FETCH_INSTR
				if: mem.ready
					rs1 = regFile[mem.rdata[19 .. 15]]
					rs2 = regFile[mem.rdata[24 .. 20]]
					instr = mem.rdata
					$goto(state.EXECUTE)

			if: state.EXECUTE
				PC = PCnext
				if: needToWait
					$goto(state.WAIT_ALU_OR_MEM)
				else:
					$goto(state.FETCH_INSTR)

			if: state.WAIT_ALU_OR_MEM
				if: !aluBusy & (~(mem.rstrb | |mem.wmask) | mem.ready)
					$goto(state.FETCH_INSTR)

	ff: +clk
		cycles = cycles + 1
