module: BusSkidBuffer:
		ADDR_WIDTH = 32
		DATA_BYTES = 4
	port:
		clk: in
		reset: in

		slave: IBus.Slave(ADDR_WIDTH = ADDR_WIDTH, DATA_BYTES = DATA_BYTES)
		master: IBus.Master(ADDR_WIDTH = ADDR_WIDTH, DATA_BYTES = DATA_BYTES)
	submodule:
		addr: SkidBuffer(WIDTH = ADDR_WIDTH + 8 + 1)
		wdata: SkidBuffer(WIDTH = DATA_BYTES * 8 + DATA_BYTES)
		rdata: SkidBuffer(WIDTH = DATA_BYTES * 8)

	addr.clk = clk
	addr.reset = reset

	wdata.clk = clk
	wdata.reset = reset

	rdata.clk = clk
	rdata.reset = reset

	@slave.skid_slave(addr, wdata, rdata)
	@master.skid_master(addr, wdata, rdata)

	\\ If our read skid buffer is full and nobody reads it,
	\\ we tell the requester that we can't get more addresses,
	\\ and tell the receiver that it does not have any new requests.
	if: ~rdata.slave.ready
		slave.a.ready = 0
		master.a.valid = 0

module: BusSkidBufferReg:
		ADDR_WIDTH = 32
		DATA_BYTES = 4
	port:
		clk: in
		reset: in

		slave: IBus.Slave(ADDR_WIDTH = ADDR_WIDTH, DATA_BYTES = DATA_BYTES)
		master: IBus.Master(ADDR_WIDTH = ADDR_WIDTH, DATA_BYTES = DATA_BYTES)
	submodule:
		addr: SkidBufferReg(WIDTH = ADDR_WIDTH + 8 + 1)
		wdata: SkidBufferReg(WIDTH = DATA_BYTES * 8 + DATA_BYTES)
		rdata: SkidBufferReg(WIDTH = DATA_BYTES * 8)

	addr.clk = clk
	addr.reset = reset

	wdata.clk = clk
	wdata.reset = reset

	rdata.clk = clk
	rdata.reset = reset

	@slave.skid_slave(addr, wdata, rdata)
	@master.skid_master(addr, wdata, rdata)

	\\ If our read skid buffer is full and nobody reads it,
	\\ we tell the requester that we can't get more addresses,
	\\ and tell the receiver that it does not have any new requests.
	if: ~rdata.slave.ready
		slave.a.ready = 0
		master.a.valid = 0
