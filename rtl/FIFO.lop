interface: FIFOPort:
		DATA_WIDTH = 8
	port: Read / Write
		data: net[DATA_WIDTH]: out / in
		valid: net: out / in
		ready: net: in / out
		last: net: out / out

module: FIFO:
		WIDTH = 32
		HEIGHT = 4
	const:
		WBYTES = $ceil(WIDTH / 8)
	port:
		clk: in
		reset: in

		rd: FIFOPort.Read(DATA_WIDTH = WIDTH)
		wr: FIFOPort.Write(DATA_WIDTH = WIDTH)

		half: out
		empty: out
		full: out

		prio_rd: in
	submodule:
		sram: SimpleSRAM(WBYTES = WBYTES, HEIGHT = HEIGHT)
	local:
		head: net[$clog2(HEIGHT)]
		tail: net[$clog2(HEIGHT)]

		head_next: net[$clog2(HEIGHT)] = head + 1
		tail_next: net[$clog2(HEIGHT)] = tail + 1
		tail_math: net[$clog2(HEIGHT)] = tail - head

		read_pending: net

	rd.last = head_next == tail
	wr.last = tail_next == head

	half = tail_math < $int(HEIGHT / 2)

	sram.clk = clk

	sram.addr = tail
	sram.wdata = wr.data
	sram.wstrb = -1
	sram.wen = wr.valid & wr.ready

	read_pending = 0

	if: ~sram.wen
		sram.addr = head
		read_pending = ~empty & rd.ready

		if: rd.valid & rd.ready
			sram.addr = head_next
			read_pending = ~rd.last

	rd.data = sram.rdata

	ff: +clk
		rd.valid = read_pending

		if: empty | (wr.valid & ~full)
			wr.ready = 1

		if: rd.ready & prio_rd
			wr.ready = 0

		if: rd.ready & ((rd.valid & ~prio_rd) | rd.last)
			wr.ready = 1

		if: wr.valid & wr.ready
			tail = tail_next
			if: wr.last
				full = 1
				wr.ready = rd.valid & rd.ready & ~prio_rd
			empty = 0

		if: rd.valid & rd.ready
			head = head_next
			if: rd.last
				empty = ~sram.wen
				rd.valid = 0
			full = 0

		if: reset
			head = 0
			tail = 0
			empty = 1
			full = 0

			rd.valid = 0
			wr.ready = 1
