interface: IBusAddr:
		ADDR_WIDTH = 32
	port: Master / Slave
		addr: net[ADDR_WIDTH]: out / in
		wen: net: out / in
		len: net[8]: out / in
		valid: net: out / in
		ready: net: in / out
	macros:
		hsdata = { addr, len, wen }

		slave(skid) = block:
			skid.data = @hsdata
			skid.valid = valid
			ready = skid.ready

		master(skid) = block:
			@hsdata = skid.data
			valid = skid.valid
			skid.ready = ready

interface: IBusWriteData:
		DATA_BYTES = 4
	port: Master / Slave
		data: net[DATA_BYTES * 8]: out / in
		strb: net[DATA_BYTES]: out / in
		valid: net: out / in
		ready: net: in / out
	macros:
		hsdata = { data, strb }

		slave(skid) = block:
			skid.data = @hsdata
			skid.valid = valid
			ready = skid.ready

		master(skid) = block:
			@hsdata = skid.data
			valid = skid.valid
			skid.ready = ready

interface: IBusReadData:
		DATA_BYTES = 4
	port: Master / Slave
		data: net[DATA_BYTES * 8]: in / out
		valid: net: in / out
		ready: net: out / in
	macros:
		hsdata = data

		slave(skid) = block:
			@hsdata = skid.data
			valid = skid.valid
			skid.ready = ready

		master(skid) = block:
			skid.data = @hsdata
			skid.valid = valid
			ready = skid.ready

interface: IBus:
		ADDR_WIDTH = 32
		DATA_BYTES = 4
	port: Master / Slave
		a: IBusAddr(ADDR_WIDTH = ADDR_WIDTH): Master / Slave
		r: IBusReadData(DATA_BYTES = DATA_BYTES): Master / Slave
		w: IBusWriteData(DATA_BYTES = DATA_BYTES): Master / Slave
	macros:
		skid_slave(addr, wdata, rdata) = block:
			@a.slave(addr.slave)
			@w.slave(wdata.slave)
			@r.slave(rdata.master)

		skid_master(addr, wdata, rdata) = block:
			@a.master(addr.master)
			@w.master(wdata.master)
			@r.master(rdata.slave)

		hit(reg, offset) = a.addr[-1 .. 2] == ($regaddr(reg)[-1 .. 2] + offset)

		is_write = a.valid & a.ready & a.wen & w.valid & w.ready
		is_read = a.valid & a.ready & ~a.wen

		read(reg) = block:
			for: i < $regsize(reg) * 8
				if: @hit(reg, i >> 5)
					if: $regrmask(reg)[i]
						r.data[$regaddr(reg)[1 .. 0] * 8 + (i & 0x1f)] = reg[i]

		clear_on_read(reg) = block:
			if: @hit(reg, 0)
				if: @is_read
					for: i < $regsize(reg) * 8
						if: $regcrmask(reg)[i]
							reg[i] = 0

		write(reg) = block:
			if: @hit(reg, 0)
				if: @is_write
					for: i
						if: w.strb[$regaddr(reg)[1 .. 0] + i]
							for: j < 8
								if: $regwmask(reg)[i * 8 + j]
									reg[i * 8 + j] = w.data[($regaddr(reg)[1 .. 0] + i) * 8 + j]
								if: $regsmask(reg)[i * 8 + j]
									if: w.data[($regaddr(reg)[1 .. 0] + i) * 8 + j]
										reg[i * 8 + j] = 1

		clear_on_set(reg) = block:
			if: @hit(reg, 0)
				if: @is_write
					for: i
						if: w.strb[$regaddr(reg)[1 .. 0] + i]
							for: j < 8
								if: $regcsmask(reg)[i * 8 + j]
									if: w.data[($regaddr(reg)[1 .. 0] + i) * 8 + j]
										reg[i * 8 + j] = 0

		access(reg) = block:
			@read(reg)
			@write(reg)
			@clear_on_read(reg)
			@clear_on_set(reg)

		header = block:
			if: r.valid & r.ready
				r.valid = 0

		trailer(reset) = block:
			if: @is_read
				r.valid = 1
			if: reset
				r.valid = 0

		is_writing_to(reg) = @is_write && @hit(reg, 0) && |w.strb[$regaddr(reg)[1 .. 0] +.. 1]

		writing_data(reg) = w.data[$regaddr(reg)[1 .. 0] * 8 +.. 8]
