interface: IUARTTransmitter
	port: Master / Slave
		data: net[8]: out / in
		valid: net: out / in
		busy: net: in / out

module: UARTTransmitter:
		UART_CLK_DIV = $int(96_000_000 / 921_600)
	port:
		clk: in
		reset: in

		intf: IUARTTransmitter.Slave

		line: out
	submodule:
		uart_clk: Counter(WIDTH = $clog2(UART_CLK_DIV))
		sr: ShiftRegister(IN_WIDTH = 1, RATIO = 10, REVERSE = 1)
	local:
		outgoing: net

	uart_clk.clk = clk
	uart_clk.set = intf.valid
	uart_clk.data = UART_CLK_DIV - 1
	uart_clk.enable = outgoing

	sr.clk = clk
	sr.r_set = reset | intf.valid
	sr.r_data = { intf.data, 1b0, 1b1 }
	sr.i_data = 1
	sr.i_valid = uart_clk.overflow

	intf.busy = outgoing

	line = sr.o_data[0]

	ff: +clk
		if: intf.valid
			$write("%c", intf.data)
			$fflush()
		if: reset | &sr.o_data
			outgoing = 0
		if: intf.valid
			outgoing = 1
